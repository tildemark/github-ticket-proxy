datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

enum Role {
  CLIENT
  AGENT
  ADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CLIENT
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketSource {
  WEB
  EMAIL
  MESSAGING
}

model Company {
  id          String       @id @default(cuid())
  name        String
  domain      String?      @unique // e.g., acme.com for domain-level recognition
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users       User[]
  tickets     Ticket[]
  invitations Invitation[]
}

// NextAuth / Auth.js standard models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Optional for OAuth users
  role          Role      @default(CLIENT)
  isActive      Boolean   @default(true) // Ability for admin to revoke/suspend access

  // Multi-company association
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  accounts      Account[]
  sessions      Session[]
  tickets       Ticket[]
  comments      Comment[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Invitation {
  id          String    @id @default(cuid())
  token       String    @unique
  email       String
  role        Role      @default(CLIENT)
  
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  invitedById String?
  
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}

model SystemSetting {
  id                       String   @id @default("global")
  allowPublicRegistration  Boolean  @default(false)
  updatedAt                DateTime @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Ticket {
  id               String         @id @default(cuid())
  subject          String
  description      String         @db.Text
  status           TicketStatus   @default(OPEN)
  priority         TicketPriority @default(MEDIUM)
  
  authorId         String
  author           User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Company-level multi-tenancy
  companyId        String?
  company          Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // GitHub Proxy Internal Fields (Hidden from Clients)
  githubIssueId    Int?
  githubIssueUrl   String?

  // Omnichannel Fields
  source           TicketSource   @default(WEB)
  externalThreadId String?

  comments         Comment[]

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Comment {
  id                String   @id @default(cuid())
  content           String   @db.Text
  ticketId          String
  ticket            Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId          String
  author            User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Internal Agent privacy flag
  isInternal        Boolean  @default(false)
  externalMessageId String?

  createdAt         DateTime @default(now())
}
