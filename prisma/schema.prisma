datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

enum Role {
  CLIENT
  AGENT
  ADMIN
}

enum EscalationTier {
  L1_SUPPORT
  L2_SENIOR
  ENGINEERING_ESCALATED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CLIENT
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketSource {
  WEB
  EMAIL
  MESSAGING
}

model Company {
  id          String       @id @default(cuid())
  name        String
  domain      String?      @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users       User[]
  tickets     Ticket[]
  invitations Invitation[]
}

// NextAuth / Auth.js standard models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(CLIENT)
  isActive      Boolean   @default(true)

  // Multi-company association
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  accounts      Account[]
  sessions      Session[]
  
  ticketsAuthored Ticket[]  @relation("TicketAuthor")
  ticketsAssigned Ticket[]  @relation("TicketAssignee")
  comments        Comment[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Invitation {
  id          String    @id @default(cuid())
  token       String    @unique
  email       String
  role        Role      @default(CLIENT)
  
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  invitedById String?
  
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}

model SystemSetting {
  id                       String   @id @default("global")
  allowPublicRegistration  Boolean  @default(false)

  // Email (SMTP / Resend)
  emailProvider            String   @default("smtp") // "smtp" | "resend" | "sendgrid"
  smtpHost                 String?
  smtpPort                 Int?     @default(587)
  smtpUser                 String?
  smtpPassword             String?
  smtpFromEmail            String?  @default("support@issuebridge.com")
  resendApiKey             String?

  // SMS (Twilio / Africa's Talking)
  smsEnabled               Boolean  @default(false)
  smsProvider              String   @default("twilio") // "twilio"
  twilioAccountSid         String?
  twilioAuthToken          String?
  twilioFromNumber         String?

  // Real-time Chat / Webhook Notifications (Slack, Discord, MS Teams)
  webhookNotificationsEnabled Boolean @default(false)
  slackWebhookUrl             String?
  discordWebhookUrl           String?

  // GitHub Default Repo Configuration
  githubRepoOwner          String?  @default("tildemark")
  githubRepoName           String?  @default("trace")
  githubDefaultLabels      String?  @default("support-escalation")

  updatedAt                DateTime @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Ticket {
  id               String         @id @default(cuid())
  subject          String
  description      String         @db.Text
  status           TicketStatus   @default(OPEN)
  priority         TicketPriority @default(MEDIUM)

  // Escalation & Assignment Fields
  tier             EscalationTier @default(L1_SUPPORT)
  assignedToId     String?
  assignedTo       User?          @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  
  authorId         String
  author           User           @relation("TicketAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  // Company-level multi-tenancy
  companyId        String?
  company          Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // GitHub Proxy Internal Fields (Hidden from Clients)
  githubIssueId    Int?
  githubIssueUrl   String?

  // Omnichannel Fields
  source           TicketSource   @default(WEB)
  externalThreadId String?

  // KPI & SLA Performance Timestamps
  firstResponseAt  DateTime?      // When support staff first replied
  escalatedAt      DateTime?      // When escalated to GitHub
  resolvedAt       DateTime?      // When ticket was solved/fixed

  comments         Comment[]
  attachments      Attachment[]

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Comment {
  id                String       @id @default(cuid())
  content           String       @db.Text
  ticketId          String
  ticket            Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId          String
  author            User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Internal Agent privacy flag
  isInternal        Boolean      @default(false)
  externalMessageId String?
  attachments       Attachment[]

  createdAt         DateTime     @default(now())
}

model Attachment {
  id        String   @id @default(cuid())
  fileName  String
  fileUrl   String
  fileType  String
  fileSize  Int

  ticketId  String?
  ticket    Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
